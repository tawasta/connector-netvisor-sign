<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_agreement_form_inherit_vismasign" model="ir.ui.view">
        <field name="name">agreement.form.vismasign.inherit</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement.agreement_form" />
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="before">
                <header>
                    <button
                        name="action_vismasign_send"
                        type="object"
                        string="Send for Signature"
                        class="btn-primary"
                        invisible="is_template or vismasign_document_uuid"
                    />
                </header>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page name="vismasign" string="Visma Sign">
                    <field name="vismasign_allow_multiple_signers" invisible="1" />
                    <div
                        name="vismasign_signers"
                        invisible="is_template or (not vismasign_allow_multiple_signers and not vismasign_signer_ids)"
                    >
                        <separator string="Signers" />
                        <p class="text-muted" invisible="vismasign_document_uuid">
                            The customer is added automatically. Add other people who also need to sign.
                        </p>
                        <field
                            name="vismasign_signer_ids"
                            readonly="vismasign_document_uuid"
                        >
                            <tree editable="bottom">
                                <field name="company_id" column_invisible="1" />
                                <field name="role" />
                                <field
                                    name="partner_id"
                                    options="{'no_create': True}"
                                />
                                <field name="email" />
                                <field name="status" widget="badge" />
                            </tree>
                        </field>
                    </div>
                    <group>
                        <group string="Status">
                            <field name="vismasign_status" readonly="1" />
                            <field name="vismasign_last_check" readonly="1" />
                        </group>
                        <group string="Identifiers">
                            <field name="vismasign_document_uuid" readonly="1" />
                            <field name="vismasign_file_uuid" readonly="1" />
                            <field name="vismasign_invitation_uuid" readonly="1" />
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
