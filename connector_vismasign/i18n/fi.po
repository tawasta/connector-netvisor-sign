#. module: connector_vismasign
#: model:ir.model.fields,field_description:connector_vismasign.field_vismasign_backend__allow_multiple_signers
msgid "Allow Multiple Signers"
msgstr "Salli useita allekirjoittajia"

#. module: connector_vismasign
#. odoo-python
#: code:addons/connector_vismasign/models/vismasign_backend.py:0
#, python-format
msgid "At least one recipient is required."
msgstr "Vähintään yksi vastaanottaja vaaditaan."

#. module: connector_vismasign
#: model:ir.model.fields,help:connector_vismasign.field_vismasign_backend__allow_multiple_signers
msgid ""
"If enabled, a document can be sent to several signers at once. If disabled, "
"only one signer per document is allowed."
msgstr ""
"Kun valinta on käytössä, dokumentti voidaan lähettää usealle "
"allekirjoittajalle kerralla. Muuten dokumentille sallitaan vain yksi "
"allekirjoittaja."

#. module: connector_vismasign
#. odoo-python
#: code:addons/connector_vismasign/models/vismasign_backend.py:0
#, python-format
msgid ""
"Multiple signers are not allowed. Enable 'Allow multiple signers' on the "
"Visma Sign backend."
msgstr ""
"Useita allekirjoittajia ei sallita. Ota käyttöön \"Salli useita "
"allekirjoittajia\" Visma Sign -backendillä."

#. module: connector_vismasign
